{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["es2024"],
    "target": "es2024",
    "moduleResolution": "bundler",
    "baseUrl": "./src",
    "rootDir": "./src",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false
  },
  "exclude": ["node_modules"]
}
